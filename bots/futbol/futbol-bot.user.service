[Unit]
Description=GlobalChat Futbol IRC bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/globalchat/futbol_bot
EnvironmentFile=-/home/globalchat/futbol_bot/config.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/globalchat/futbol_bot/futbol_bot.py -v
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
