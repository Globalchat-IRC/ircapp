[Unit]
Description=GlobalChat Futbol bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/globalchat/irc_app/bots/futbol
ExecStart=/opt/globalchat/irc_app/bots/futbol/run.sh
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
