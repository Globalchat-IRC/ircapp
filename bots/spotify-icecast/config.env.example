# Spotify Developer Dashboard: https://developer.spotify.com/dashboard
# Redirect URI en la app: http://127.0.0.1:8765/callback
#
# Permisos del script (solo lectura, no controla ni pausa tu Spotify):
#   - user-read-currently-playing
#   - user-read-playback-state
# No cierra sesión en otros dispositivos ni cambia lo que suena.
SPOTIFY_CLIENT_ID=tu_client_id
SPOTIFY_CLIENT_SECRET=tu_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback

# Icecast (admin/metadata desde icecast.xml)
ICECAST_URL=http://tu-servidor:8000
ICECAST_MOUNT=/radio
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=tu_password_admin

# Cada cuánto consultar Spotify (segundos)
POLL_SEC=5
IDLE_POLL_SEC=15

# IRC (#QualiaRadio): anuncio + letra de la canción (LRCLIB / lyrics.ovh)
IRC_ENABLED=true
IRC_HOST=ceres.globalchat.org
IRC_PORT=6697
IRC_NICK=QualiaSong
IRC_CHANNEL=#QualiaRadio
IRC_LYRICS_ENABLED=true
IRC_LYRICS_MAX_LINES=12
IRC_LYRICS_LINE_DELAY=0.35
