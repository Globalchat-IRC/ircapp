# Colores para la terminal
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

# Obtener el directorio de la aplicación
APP_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
RESOURCES_DIR="$APP_DIR/Contents/Resources"

# Función para verificar e instalar FFmpeg
check_and_install_ffmpeg() {
    # Asegurarse de que Homebrew esté en el PATH
    if [ -f "/opt/homebrew/bin/brew" ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
        export PATH="/opt/homebrew/bin:$PATH"
    elif [ -f "/usr/local/bin/brew" ]; then
        eval "$(/usr/local/bin/brew shellenv)"
        export PATH="/usr/local/bin:$PATH"
    fi
    
    # Buscar ffmpeg en las rutas comunes de Homebrew
    if command -v ffmpeg &> /dev/null; then
        return 0
    elif [ -f "/opt/homebrew/bin/ffmpeg" ]; then
        export PATH="/opt/homebrew/bin:$PATH"
        eval "$(/opt/homebrew/bin/brew shellenv)"
        return 0
    elif [ -f "/usr/local/bin/ffmpeg" ]; then
        export PATH="/usr/local/bin:$PATH"
        eval "$(/usr/local/bin/brew shellenv)"
        return 0
    fi
    
    # Si no se encuentra ffmpeg, preguntar si desea instalarlo
    if ! command -v ffmpeg &> /dev/null; then
        # Mostrar diálogo de instalación
        local response=$(osascript <<EOF
set dialogResult to display dialog "FFmpeg no está instalado en tu Mac.\n\nFFmpeg es necesario para convertir archivos de audio.\n\n¿Deseas instalarlo automáticamente?" buttons {"Cancelar", "Instalar FFmpeg"} default button "Instalar FFmpeg" with icon caution with title "Instalación requerida"
button returned of dialogResult
EOF
)
        
        if [ "$response" = "Instalar FFmpeg" ]; then
            # Verificar si Homebrew está instalado
            if ! command -v brew &> /dev/null; then
                # Instalar Homebrew primero
                osascript -e 'display notification "Instalando Homebrew..." with title "Convertidor M4A a MP3" subtitle "Esto puede tardar unos minutos"'
                
                # Instalar Homebrew en segundo plano con barra de progreso
                (
                    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" < /dev/null
                    
                    # Agregar Homebrew al PATH
                    if [ -f "/opt/homebrew/bin/brew" ]; then
                        eval "$(/opt/homebrew/bin/brew shellenv)"
                    elif [ -f "/usr/local/bin/brew" ]; then
                        eval "$(/usr/local/bin/brew shellenv)"
                    fi
                ) &
                
                local brew_pid=$!
                
                # Mostrar progreso mientras se instala Homebrew
                osascript -e 'display dialog "Instalando Homebrew...\n\nEsto es necesario para instalar FFmpeg.\nPor favor espera, puede tardar varios minutos.\n\nLa aplicación continuará automáticamente." buttons {"Esperar"} default button "Esperar" with icon note with title "Instalación en progreso" giving up after 300'
                
                wait $brew_pid
            fi
            
            # Asegurarse de que brew esté en el PATH
            if [ -f "/opt/homebrew/bin/brew" ]; then
                export PATH="/opt/homebrew/bin:$PATH"
                eval "$(/opt/homebrew/bin/brew shellenv)"
            elif [ -f "/usr/local/bin/brew" ]; then
                export PATH="/usr/local/bin:$PATH"
                eval "$(/usr/local/bin/brew shellenv)"
            fi
            
            # Instalar FFmpeg
            osascript -e 'display notification "Instalando FFmpeg..." with title "Convertidor M4A a MP3" subtitle "Esto puede tardar unos minutos"'
            
            # Instalar FFmpeg en segundo plano
            (
                if command -v brew &> /dev/null; then
                    brew install ffmpeg 2>&1
                else
                    exit 1
                fi
            ) &
            
            local ffmpeg_pid=$!
            
            # Mostrar progreso mientras se instala FFmpeg
            osascript -e 'display dialog "Instalando FFmpeg...\n\nPor favor espera, puede tardar varios minutos.\n\nLa aplicación continuará automáticamente cuando termine." buttons {"Esperar"} default button "Esperar" with icon note with title "Instalación en progreso" giving up after 600'
            
            wait $ffmpeg_pid
            
            # Verificar si la instalación fue exitosa
            # Asegurarse de que Homebrew esté en el PATH después de la instalación
            if [ -f "/opt/homebrew/bin/brew" ]; then
                eval "$(/opt/homebrew/bin/brew shellenv)"
            elif [ -f "/usr/local/bin/brew" ]; then
                eval "$(/usr/local/bin/brew shellenv)"
            fi
            
            if command -v ffmpeg &> /dev/null || [ -f "/opt/homebrew/bin/ffmpeg" ] || [ -f "/usr/local/bin/ffmpeg" ]; then
                osascript -e 'display dialog "✅ FFmpeg instalado correctamente!\n\nYa puedes usar el convertidor." buttons {"Continuar"} default button "Continuar" with icon note with title "Instalación completada"'
                
                # Actualizar PATH para esta sesión
                if [ -f "/opt/homebrew/bin/ffmpeg" ]; then
                    export PATH="/opt/homebrew/bin:$PATH"
                    eval "$(/opt/homebrew/bin/brew shellenv)"
                elif [ -f "/usr/local/bin/ffmpeg" ]; then
                    export PATH="/usr/local/bin:$PATH"
                    eval "$(/usr/local/bin/brew shellenv)"
                fi
            else
                osascript -e 'display dialog "❌ Error al instalar FFmpeg.\n\nPor favor, instálalo manualmente:\n\n1. Abre Terminal\n2. Ejecuta: brew install ffmpeg\n3. Vuelve a abrir esta aplicación" buttons {"OK"} default button "OK" with icon stop with title "Error de instalación"'
                exit 1
            fi
        else
            exit 1
        fi
    fi
}

