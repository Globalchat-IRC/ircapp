# Función para convertir archivo
convert_file() {
    local input_file="$1"
    local output_file="${input_file%.m4a}.mp3"
    
    # Asegurarse de que Homebrew esté en el PATH
    if [ -f "/opt/homebrew/bin/brew" ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [ -f "/usr/local/bin/brew" ]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi
    
    # Asegurarse de que ffmpeg esté en el PATH
    local ffmpeg_cmd="ffmpeg"
    if command -v ffmpeg &> /dev/null; then
        ffmpeg_cmd="ffmpeg"
    elif [ -f "/opt/homebrew/bin/ffmpeg" ]; then
        ffmpeg_cmd="/opt/homebrew/bin/ffmpeg"
        export PATH="/opt/homebrew/bin:$PATH"
    elif [ -f "/usr/local/bin/ffmpeg" ]; then
        ffmpeg_cmd="/usr/local/bin/ffmpeg"
        export PATH="/usr/local/bin:$PATH"
    fi
    
    # Convertir con calidad alta (320kbps) sin mostrar output de ffmpeg
    if "$ffmpeg_cmd" -i "$input_file" -codec:a libmp3lame -b:a 320k "$output_file" -y -loglevel error 2>&1; then
        return 0
    else
        return 1
    fi
}

# Función para descargar desde YouTube
download_from_youtube() {
    local youtube_url="$1"
    local output_format="$2"  # "mp3" o "m4a"
    local output_dir="$3"
    local error_log="/tmp/youtube_download_error.log"
    
    # Asegurarse de que Homebrew esté en el PATH
    if [ -f "/opt/homebrew/bin/brew" ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [ -f "/usr/local/bin/brew" ]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi
    
    # Asegurarse de que yt-dlp esté en el PATH
    local ytdlp_cmd="yt-dlp"
    if command -v yt-dlp &> /dev/null; then
        ytdlp_cmd="yt-dlp"
    elif [ -f "/opt/homebrew/bin/yt-dlp" ]; then
        ytdlp_cmd="/opt/homebrew/bin/yt-dlp"
        export PATH="/opt/homebrew/bin:$PATH"
    elif [ -f "/usr/local/bin/yt-dlp" ]; then
        ytdlp_cmd="/usr/local/bin/yt-dlp"
        export PATH="/usr/local/bin:$PATH"
    fi
    
    # Verificar que yt-dlp existe
    if ! command -v "$ytdlp_cmd" &> /dev/null && [ ! -f "$ytdlp_cmd" ]; then
        echo "ERROR: yt-dlp no se encuentra en el sistema" > "$error_log"
        return 1
    fi
    
    # Descargar y convertir, capturando errores
    local exit_code=0
    if [ "$output_format" = "mp3" ]; then
        # Para MP3, descargar como audio y convertir con ffmpeg
        "$ytdlp_cmd" -x --audio-format mp3 --audio-quality 320K \
            -o "$output_dir/%(title)s.%(ext)s" \
            "$youtube_url" > "$error_log" 2>&1
        exit_code=$?
    else
        # Para M4A, descargar directamente
        "$ytdlp_cmd" -x --audio-format m4a \
            -o "$output_dir/%(title)s.%(ext)s" \
            "$youtube_url" > "$error_log" 2>&1
        exit_code=$?
    fi
    
    # Si hay error, guardar el mensaje
    if [ $exit_code -ne 0 ]; then
        # Extraer el mensaje de error más relevante
        local error_msg=$(tail -5 "$error_log" | grep -i "error\|unavailable\|private\|restricted\|not found" | head -1 || tail -1 "$error_log")
        echo "$error_msg" > "$error_log"
    fi
    
    return $exit_code
}

# Función principal con interfaz gráfica mejorada
main() {
    # Agregar rutas de Homebrew al PATH y evaluar shellenv
    if [ -f "/opt/homebrew/bin/brew" ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
        export PATH="/opt/homebrew/bin:$PATH"
    elif [ -f "/usr/local/bin/brew" ]; then
        eval "$(/usr/local/bin/brew shellenv)"
        export PATH="/usr/local/bin:$PATH"
    else
        # Si no hay Homebrew, agregar rutas comunes de todas formas
        if [ -d "/opt/homebrew/bin" ]; then
            export PATH="/opt/homebrew/bin:$PATH"
        fi
        if [ -d "/usr/local/bin" ]; then
            export PATH="/usr/local/bin:$PATH"
        fi
    fi
    
    # Verificar FFmpeg
    check_and_install_ffmpeg
    
    # Asegurarse de que ffmpeg esté en el PATH después de verificar
    if [ -f "/opt/homebrew/bin/brew" ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [ -f "/usr/local/bin/brew" ]; then
        eval "$(/usr/local/bin/brew shellenv)"
    fi
    
    # Mostrar menú principal (máximo 3 botones permitidos por macOS)
    local choice=$(osascript <<EOF
set dialogResult to display dialog "🎵 Convertidor M4A → MP3\n\n© 2026 Fran para sonic\n\nSelecciona qué deseas hacer:" buttons {"Salir", "YouTube", "Convertir"} default button "Convertir" with title "Convertidor M4A a MP3" with icon note
button returned of dialogResult
EOF
)
    
    # Si eligió "Convertir", mostrar submenú
    if [ "$choice" = "Convertir" ]; then
        choice=$(osascript <<EOF
set dialogResult to display dialog "¿Qué deseas convertir?" buttons {"Cancelar", "Carpeta completa", "Archivos individuales"} default button "Archivos individuales" with title "Convertir archivos" with icon note
button returned of dialogResult
EOF
)
    fi
    
    case "$choice" in
        "Archivos individuales")
            # Seleccionar archivos
            local files=$(osascript <<EOF
set fileList to choose file with prompt "Selecciona archivos M4A para convertir:" of type {"public.audio", "m4a", "M4A"} with multiple selections allowed
set output to ""
repeat with aFile in fileList
    set output to output & POSIX path of aFile & "\n"
end repeat
return output
EOF
)
            
            if [ -z "$files" ]; then
                osascript -e 'display dialog "No se seleccionaron archivos." buttons {"OK"} default button "OK" with icon stop with title "Cancelado"'
                exit 0
            fi
            
            # Mostrar progreso
            local total=0
            local success=0
            local failed_files=""
            
            # Contar archivos
            while IFS= read -r file; do
                if [ -n "$file" ] && [ -f "$file" ]; then
                    ((total++))
                fi
            done <<< "$files"
            
            # Convertir archivos
            local current=0
            while IFS= read -r file; do
                if [ -n "$file" ] && [ -f "$file" ]; then
                    ((current++))
                    local filename=$(basename "$file")
                    
                    # Mostrar progreso
                    osascript -e "display notification \"Convirtiendo: $filename\" with title \"Convertidor M4A a MP3\" subtitle \"Archivo $current de $total\"" &
                    
                    if convert_file "$file"; then
                        ((success++))
                    else
                        failed_files="$failed_files\n- $filename"
                    fi
                fi
            done <<< "$files"
            
            # Mostrar resultado
            if [ $success -eq $total ]; then
                osascript <<EOF
display dialog "✅ Conversión completada exitosamente!\n\n$success de $total archivos convertidos.\n\nLos archivos MP3 están en la misma carpeta que los originales." buttons {"Abrir carpeta", "OK"} default button "OK" with icon note with title "¡Completado!"
set dialogResult to result
if button returned of dialogResult is "Abrir carpeta" then
    tell application "Finder"
        activate
        reveal POSIX file "$(dirname "$file")"
    end tell
end if
EOF
            else
                local failed=$((total - success))
                osascript -e "display dialog \"⚠️ Conversión completada con errores\n\n✓ Exitosos: $success\n✗ Fallidos: $failed\n\nArchivos con error:$failed_files\" buttons {\"OK\"} default button \"OK\" with icon caution with title \"Completado con errores\""
            fi
            ;;
            
        "Carpeta completa")
            # Seleccionar carpeta
            local folder=$(osascript <<EOF
set folderPath to choose folder with prompt "Selecciona la carpeta con archivos M4A:"
return POSIX path of folderPath
EOF
)
            
            if [ -z "$folder" ]; then
                osascript -e 'display dialog "No se seleccionó ninguna carpeta." buttons {"OK"} default button "OK" with icon stop with title "Cancelado"'
                exit 0
            fi
            
            # Buscar archivos M4A
            local m4a_files=$(find "$folder" -type f \( -iname "*.m4a" \) 2>/dev/null)
            local total=$(echo "$m4a_files" | grep -c .)
            
            if [ $total -eq 0 ]; then
                osascript -e 'display dialog "No se encontraron archivos M4A en la carpeta seleccionada." buttons {"OK"} default button "OK" with icon caution with title "Sin archivos"'
                exit 0
            fi
            
            # Confirmar conversión
            local confirm=$(osascript -e "display dialog \"Se encontraron $total archivos M4A.\n\n¿Deseas convertirlos todos a MP3?\" buttons {\"Cancelar\", \"Convertir\"} default button \"Convertir\" with icon note with title \"Confirmar conversión\"" -e "button returned of result")
            
            if [ "$confirm" != "Convertir" ]; then
                exit 0
            fi
            
            # Convertir archivos
            local success=0
            local current=0
            local failed_files=""
            
            while IFS= read -r file; do
                if [ -n "$file" ] && [ -f "$file" ]; then
                    ((current++))
                    local filename=$(basename "$file")
                    
                    # Mostrar progreso
                    osascript -e "display notification \"Convirtiendo: $filename\" with title \"Convertidor M4A a MP3\" subtitle \"Archivo $current de $total\"" &
                    
                    if convert_file "$file"; then
                        ((success++))
                    else
                        failed_files="$failed_files\n- $filename"
                    fi
                fi
            done <<< "$m4a_files"
            
            # Mostrar resultado
            if [ $success -eq $total ]; then
                osascript <<EOF
display dialog "✅ Conversión completada exitosamente!\n\n$success de $total archivos convertidos.\n\nLos archivos MP3 están en la misma carpeta que los originales." buttons {"Abrir carpeta", "OK"} default button "OK" with icon note with title "¡Completado!"
set dialogResult to result
if button returned of dialogResult is "Abrir carpeta" then
    tell application "Finder"
        activate
        reveal POSIX file "$folder"
    end tell
end if
EOF
            else
                local failed=$((total - success))
                osascript -e "display dialog \"⚠️ Conversión completada con errores\n\n✓ Exitosos: $success\n✗ Fallidos: $failed\n\nAlgunos archivos no se pudieron convertir.\" buttons {\"OK\"} default button \"OK\" with icon caution with title \"Completado con errores\""
            fi
            ;;
            
        "YouTube")
            # Verificar yt-dlp
            if ! check_and_install_ytdlp; then
                exit 1
            fi
            
            # Solicitar URL de YouTube
            local youtube_url=$(osascript <<EOF
set dialogResult to display dialog "Ingresa la URL del video de YouTube:" default answer "" buttons {"Cancelar", "Continuar"} default button "Continuar" with title "Descargar desde YouTube" with icon note
text returned of dialogResult
EOF
)
            
            if [ -z "$youtube_url" ] || [ "$youtube_url" = "" ]; then
                osascript -e 'display dialog "No se ingresó ninguna URL." buttons {"OK"} default button "OK" with icon stop with title "Cancelado"'
                exit 0
            fi
            
            # Validar que sea una URL de YouTube
            if [[ ! "$youtube_url" =~ ^https?://(www\.)?(youtube\.com|youtu\.be) ]]; then
                osascript -e 'display dialog "La URL no parece ser de YouTube.\n\nPor favor, ingresa una URL válida de YouTube." buttons {"OK"} default button "OK" with icon caution with title "URL inválida"'
                exit 0
            fi
            
            # Elegir formato de salida
            local format_choice=$(osascript <<EOF
set dialogResult to display dialog "¿En qué formato deseas descargar el audio?" buttons {"M4A", "MP3"} default button "MP3" with title "Formato de salida" with icon note
button returned of dialogResult
EOF
)
            
            # Elegir carpeta de destino
            local output_dir=$(osascript <<EOF
set folderPath to choose folder with prompt "Selecciona dónde guardar el archivo:"
return POSIX path of folderPath
EOF
)
            
            if [ -z "$output_dir" ]; then
                osascript -e 'display dialog "No se seleccionó ninguna carpeta." buttons {"OK"} default button "OK" with icon stop with title "Cancelado"'
                exit 0
            fi
            
            # Mostrar progreso
            osascript -e "display notification \"Descargando desde YouTube...\" with title \"Convertidor M4A a MP3\" subtitle \"Esto puede tardar unos minutos\""
            
            # Descargar
            local format_lower=$(echo "$format_choice" | tr '[:upper:]' '[:lower:]')
            local error_log="/tmp/youtube_download_error.log"
            
            if download_from_youtube "$youtube_url" "$format_lower" "$output_dir"; then
                # Verificar que el archivo se descargó
                local downloaded_file=$(find "$output_dir" -type f \( -name "*.mp3" -o -name "*.m4a" \) -newer "$error_log" 2>/dev/null | head -1)
                
                if [ -n "$downloaded_file" ]; then
                    osascript <<EOF
display dialog "✅ Descarga completada exitosamente!\n\nEl archivo $format_choice está en la carpeta seleccionada." buttons {"Abrir carpeta", "OK"} default button "OK" with icon note with title "¡Completado!"
set dialogResult to result
if button returned of dialogResult is "Abrir carpeta" then
    tell application "Finder"
        activate
        reveal POSIX file "$output_dir"
    end tell
end if
EOF
                else
                    osascript -e "display dialog \"⚠️ La descarga parece haber terminado, pero no se encontró el archivo.\n\nVerifica la carpeta de destino.\" buttons {\"OK\"} default button \"OK\" with icon caution with title \"Advertencia\""
                fi
            else
                # Leer el error específico
                local error_detail=""
                if [ -f "$error_log" ]; then
                    error_detail=$(cat "$error_log" | head -3 | tr '\n' ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
                fi
                
                # Construir mensaje de error más detallado
                local error_message="❌ Error al descargar el video."
                if [ -n "$error_detail" ] && [ ${#error_detail} -lt 200 ]; then
                    error_message="$error_message\n\nDetalle: $error_detail"
                fi
                error_message="$error_message\n\nVerifica que:\n- La URL sea correcta\n- Tengas conexión a internet\n- El video no esté restringido o privado\n- yt-dlp esté actualizado (brew upgrade yt-dlp)"
                
                osascript -e "display dialog \"$error_message\" buttons {\"OK\"} default button \"OK\" with icon stop with title \"Error\""
            fi
            ;;
            
        *)
            exit 0
            ;;
    esac
}

# Ejecutar aplicación
main
